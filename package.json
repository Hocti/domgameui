{
	"name": "domgameui",
	"version": "1.1.0",
	"description": "creating game user interfaces using standard DOM elements, with gamepads or keyboard",
	"main": "./dist/domgameui.cjs.js",
	"module": "./dist/domgameui.esm.js",
	"bundle": "./dist/domgameui.js",
	"types": "./dist/domgameui.d.ts",
	"namespace": "domgameui",
	"exports": {
		".": {
			"import": {
				"types": "./dist/domgameui.d.ts",
				"default": "./dist/domgameui.esm.js"
			},
			"require": {
				"types": "./dist/domgameui.d.ts",
				"default": "./dist/domgameui.cjs.js"
			}
		}
	},
	"scripts": {
		"watch": "cross-env NODE_ENV=DEV rollup -c --watch",
		"build": "cross-env NODE_ENV=production rollup -c",
		"lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0"
	},
	"keywords": [
		"controller",
		"gamepad",
		"keyboard",
		"multiplayer",
		"dom",
		"ui"
	],
	"author": "hocti",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Hocti/domgameui/"
	},
	"files": [
		"./dist/",
		"LICENSE",
		"package.json",
		"README.md"
	],
	"devDependencies": {
		"@rollup/plugin-commonjs": "^28.0.6",
		"@rollup/plugin-node-resolve": "^16.0.1",
		"concurrently": "^9.2.0",
		"cross-env": "^7.0.3",
		"esbuild": "^0.25.5",
		"eslint": "^9.30.1",
		"rollup": "^4.44.1",
		"rollup-plugin-dts": "^6.2.1",
		"rollup-plugin-esbuild": "^6.2.1",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"controlwrap": "workspace:*",
		"lit": "^3.3.0"
	}
}